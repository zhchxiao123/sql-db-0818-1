statement ok
CREATE TABLE ct(a INTEGER, b TEXT)

statement ok
INSERT INTO ct VALUES(1, '1'),(2, '2'),(3, 'x')

query I
SELECT CAST(b AS INTEGER) FROM ct ORDER BY a
----
1
2
0

query I
SELECT CAST(b AS INTEGER)=a FROM ct ORDER BY a
----
1
1
0

query I
SELECT a=CAST(b AS INTEGER) FROM ct ORDER BY a
----
1
1
0

query T
SELECT CAST(a AS TEXT) FROM ct ORDER BY a
----
1
2
3

