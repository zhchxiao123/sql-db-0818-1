statement ok
CREATE TABLE t2(a TEXT COLLATE NOCASE, b TEXT COLLATE BINARY)

statement ok
INSERT INTO t2 VALUES('apple','Z'),('Apple','y'),('banana','X'),('BANANA','w'),('cherry','v')

query T
SELECT a FROM t2 ORDER BY a
----
apple
Apple
banana
BANANA
cherry

query T
SELECT a FROM t2 ORDER BY a COLLATE BINARY
----
Apple
BANANA
apple
banana
cherry

query T
SELECT a FROM t2 ORDER BY a DESC
----
cherry
banana
BANANA
apple
Apple

query T
SELECT b FROM t2 ORDER BY b
----
X
Z
v
w
y

query T
SELECT a FROM t2 ORDER BY a LIMIT 2 OFFSET 1
----
Apple
banana

query T
SELECT DISTINCT a FROM t2 ORDER BY a
----
apple
banana
cherry

