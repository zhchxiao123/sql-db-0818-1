statement ok
CREATE TABLE t1(a1 INTEGER, a2 INTEGER, a3 INTEGER, a4 INTEGER, a5 INTEGER)

statement ok
INSERT INTO t1 VALUES(5,4,3,2,1),(1,2,3,4,5),(3,3,3,3,3),(2,4,1,5,3),(4,1,5,2,3)

