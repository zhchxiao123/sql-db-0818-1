statement ok
CREATE TABLE t2(a TEXT COLLATE NOCASE, b TEXT COLLATE BINARY)

statement ok
INSERT INTO t2 VALUES('one','one'),('One','One'),('ONE','ONE')

query I
SELECT a=b FROM t2 ORDER BY a
----
1
1
1

query I
SELECT a=b COLLATE NOCASE FROM t2 ORDER BY a
----
1
1
1

query I
SELECT a<b FROM t2 ORDER BY a
----
0
0
0

query I
SELECT a>b FROM t2 ORDER BY a
----
0
0
0

