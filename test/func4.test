query T
SELECT printf('%d+%d=%d', 1, 2, 3)
----
1+2=3

query T
SELECT printf('%q', 'it''s')
----
it''s

query T
SELECT printf('%q', 'a''b''c')
----
a''b''c

query I
SELECT like('a%', 'abc')
----
1

query I
SELECT like('%z', 'abc')
----
0

query I
SELECT like('A%', 'abc')
----
1

query I
SELECT like('a_c', 'abc')
----
1

query I
SELECT glob('a*', 'abc')
----
1

query I
SELECT glob('A*', 'abc')
----
0

query I
SELECT glob('a?c', 'abc')
----
1

query I
SELECT glob('a[bc]c', 'abc')
----
1

query I
SELECT like(NULL, 'abc')
----
NULL

query I
